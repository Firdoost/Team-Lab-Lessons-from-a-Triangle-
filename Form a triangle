import turtle
wn = turtle.Screen()
bob = turtle.Turtle()

import math
leg_1= 60
leg_2= 80 
hypotenuse= math.sqrt((leg_1**2)+(leg_2**2))
hypotenuse_int=int(hypotenuse)                     
sides= [leg_1, hypotenuse_int, leg_2]
angles= [126.87,143.13,90]
#triangle
for i in range(3):
    bob.forward(sides[i])
    bob.left(angles[i])

bob.penup()
bob.goto(150, 0)
bob.pendown()
#square
for i in range (4):
   bob.forward(60)
   bob.left(90)

bob.penup()
bob.goto(200, 150)
bob.pendown()
#hexagon
for i in range(6):
  bob.forward(60)
  bob.left(60)
wn.exitonclick()       
